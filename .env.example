# Use "usb" for automatic USB-camera discovery or specify /dev/videoN.
VIDEO_SOURCE=usb

# Stable X11/VNC display and reliable inference rate for Raspberry Pi 5.
VIDEO_SINK=ximagesink
VIDEO_FRAME_RATE=30

# Known-good custom model used when no production release is selected.
# Paths are relative to this bird-tracker directory.
MODEL_HEF_PATH=models/v0.0.4/model.hef
MODEL_LABELS_JSON=models/v0.0.4/labels.json

# Only these model labels may drive the pan/tilt arm. Humans are excluded.
PEST_TARGET_LABELS=bird,monkey

# Minimum confidence for pest detections (0.0 to 1.0).
PEST_CONFIDENCE=0.5

# Keep the last valid target box across short inference misses (seconds).
PEST_DETECTION_HOLD=1.0

# Keep Hailo tracker state for about 3 seconds at 30 FPS.
HAILO_TRACKER_KEEP_NEW_FRAMES=3
HAILO_TRACKER_KEEP_TRACKED_FRAMES=60
HAILO_TRACKER_KEEP_LOST_FRAMES=30

# Uncomment to select a controller. When unset, USB discovery is automatic.
# SERVO_PORT=/dev/serial/by-id/your-device
# Set to 0 for detection tests that must not move the arm.
SERVO_ENABLED=1

# Servo home position in normal 0..180 coordinates (tilt, pan = 80, 70).
SERVO_HOME_TILT=80
SERVO_HOME_PAN=70
SERVO_PAN_SIGN=1
SERVO_TILT_SIGN=1

# Smooth tracking defaults. Speeds are servo degrees per second.
TRACKING_FILTER_TAU=0.08
TRACKING_DEADZONE_ENTER=0.01
TRACKING_DEADZONE_EXIT=0.004
TRACKING_PAN_GAIN=80.0
TRACKING_TILT_GAIN=60.0
TRACKING_MAX_SPEED=30.0
TRACKING_LOOKAHEAD=0.14

# Follow recent screen velocity for 0.6 seconds, then search toward the exit
# edge for up to 1.2 seconds.
LOST_TARGET_VELOCITY_TAU=0.15
LOST_TARGET_COAST_SECONDS=0.60
LOST_TARGET_SEARCH_SECONDS=1.20
LOST_TARGET_MIN_SPEED=0.12
LOST_TARGET_MAX_SPEED=2.0
LOST_TARGET_EDGE_ZONE=0.20
LOST_TARGET_SEARCH_ERROR=0.30
LOST_TARGET_MARGIN=0.20

# Hailo runtime configuration. Change hailo_arch to hailo8l when appropriate.
host_arch=arm
hailo_arch=hailo8
resources_path=/usr/local/hailo/resources
tappas_postproc_path=/usr/lib/aarch64-linux-gnu/hailo/tappas/post_processes

# Match these values to the Hailo software installed on the target computer.
model_zoo_version=v2.14.0
hailort_version=4.20.0-1
tappas_version=3.31.0
virtual_env_name=venv
server_url=http://dev-public.hailo.ai/2025_01
tappas_variant=hailo-tappas-core
