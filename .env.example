# Paths may be absolute or relative to this bird-tracker directory.
HAILO_EXAMPLES_DIR=../hailo-rpi5-examples
# BIRD_TRACKER_PYTHON=../hailo-rpi5-examples/venv/bin/python

# Use "usb" for automatic USB-camera discovery or specify /dev/videoN.
BIRD_VIDEO_SOURCE=usb

# Stable X11/VNC display and reliable inference rate for Raspberry Pi 5.
BIRD_VIDEO_SINK=ximagesink
BIRD_FRAME_RATE=15

# Minimum confidence for bird detections (0.0 to 1.0).
BIRD_CONFIDENCE=0.20

# Keep the last valid bird box across short inference misses (seconds).
BIRD_DETECTION_HOLD=1.0

# Keep Hailo tracker state through brief detector misses before prediction.
BIRD_TRACKER_KEEP_NEW_FRAMES=3
BIRD_TRACKER_KEEP_TRACKED_FRAMES=10
BIRD_TRACKER_KEEP_LOST_FRAMES=4

# Uncomment to select a controller. When unset, USB discovery is automatic.
# BIRD_SERVO_PORT=/dev/serial/by-id/your-device

# Servo home position in normal 0..180 coordinates (tilt, pan = 80, 70).
BIRD_HOME_TILT=80
BIRD_HOME_PAN=70
BIRD_PAN_SIGN=1
BIRD_TILT_SIGN=1

# Smooth tracking defaults. Speeds are servo degrees per second.
BIRD_TARGET_FILTER_TAU=0.05
BIRD_DEADZONE_ENTER=0.06
BIRD_DEADZONE_EXIT=0.035
BIRD_TRACK_GAIN=130.0
BIRD_MAX_TARGET_SPEED=30.0

# Follow recent screen velocity for 0.6 seconds, then search toward the exit
# edge for up to 1.2 seconds.
BIRD_PREDICTION_VELOCITY_TAU=0.15
BIRD_PREDICTION_COAST=0.60
BIRD_PREDICTION_SEARCH=1.20
BIRD_PREDICTION_MIN_SPEED=0.12
BIRD_PREDICTION_MAX_SPEED=2.0
BIRD_PREDICTION_EDGE_ZONE=0.20
BIRD_PREDICTION_SEARCH_ERROR=0.30
BIRD_PREDICTION_MARGIN=0.20

# Hailo runtime configuration. Change hailo_arch to hailo8l when appropriate.
host_arch=arm
hailo_arch=hailo8
resources_path=/usr/local/hailo/resources
tappas_postproc_path=/usr/lib/aarch64-linux-gnu/hailo/tappas/post_processes

# Match these values to the Hailo software installed on the target computer.
model_zoo_version=v2.14.0
hailort_version=4.20.0-1
tappas_version=3.31.0
virtual_env_name=venv
server_url=http://dev-public.hailo.ai/2025_01
tappas_variant=hailo-tappas-core
